  [[117.643, 9.632], [118.697, 11.527]],    // 巴拉望岛西南
  [[119.246, 16.306], [119.519, 18.755]],   // 南沙群岛东北
  [[119.876, 19.744], [121.423, 21.200]],   // 巴士海峡
  [[121.948, 21.451], [122.612, 22.241]],   // 台湾台东以东
];

const land: any = feature(world as any, (world as any).objects.countries as any);
const features: any[] = (land as any).features;
const countriesList: any[] = countries as any;

// world-atlas 英文名 → world-countries 的 name.common 映射(两者命名存在差异)
const nameToCommon: Record<string, string> = {
  'United States of America': 'United States',
  'Dem. Rep. Congo': 'DR Congo',
  'Congo': 'Republic of the Congo',
  'S. Sudan': 'South Sudan',
  'Bosnia and Herz.': 'Bosnia and Herzegovina',
  'W. Sahara': 'Western Sahara',
  'Central African Rep.': 'Central African Republic',
  'Dominican Rep.': 'Dominican Republic',
  'Solomon Is.': 'Solomon Islands',
  'Marshall Is.': 'Marshall Islands',
  'Falkland Is.': 'Falkland Islands',
  'São Tomé and Principe': 'São Tomé and Príncipe',
  'eSwatini': 'Eswatini',
  'St. Vin. and Gren.': 'Saint Vincent and the Grenadines',
  'St. Lucia': 'Saint Lucia',
  'Antigua and Barb.': 'Antigua and Barbuda',
  'Trinidad and Tobago': 'Trinidad and Tobago',
  'Fr. S. Antarctic Lands': 'French Southern and Antarctic Lands',
  'Equatorial Guinea': 'Equatorial Guinea',
  'New Caledonia': 'New Caledonia',
  'Greenland': 'Greenland',
};

const capitalOf = (enName: string): string => {
  const common = nameToCommon[enName] ?? enName;
  const c = countriesList.find((x) => x.name.common === common);
  const en = c?.capital?.[0] ?? '';
  return zhCapitals[en] ?? en;
};

function hueOf(name: string): number {
  let h = 0;
  for (const ch of name) h = (h * 31 + (ch.codePointAt(0) ?? 0)) % 360;
  return h;
}

// 中国(含台湾)在 world-atlas 数据中的 ISO 数值 id
const CHINA_ID = '156';
const TAIWAN_ID = '158';
const isCN = (f: any) => f.id === CHINA_ID || f.id === TAIWAN_ID;
const zhNameOf = (f: any) => zhNames[f.properties.name] ?? f.properties.name;
const fullNameOf = (f: any) => fullNames[f.properties.name] ?? zhNameOf(f);

const projection = geoNaturalEarth1().fitSize([1400, 700], land);
const path = geoPath(projection);

// 九段线投影:每段线性插值 9 个点,渲染成高精度的平滑折线
const interp = (a: [number, number], b: [number, number], t: number): [number, number] => [
  a[0] + (b[0] - a[0]) * t,
  a[1] + (b[1] - a[1]) * t,
];
const dashPaths = nineDashSegments
  .map(([a, b]) => {
    const N = 8;
    const pts = Array.from({ length: N + 1 }, (_, i) => interp(a, b, i / N))
      .map(([lon, lat]) => projection([lon, lat]))
      .filter((p): p is [number, number] => !!p);
    return pts.map((p, i) => (i === 0 ? `M${p[0]},${p[1]}` : `L${p[0]},${p[1]}`)).join('');
  })
  .filter((d) => d.length > 0);

const mapData = features.map((f) => ({
  d: path(f) ?? '',
  cn: isCN(f),
  name: zhNameOf(f),
  full: fullNameOf(f),
  cap: capitalOf(f.properties.name),
  hc: `hsl(${hueOf(f.properties.name as string)}, 65%, 55%)`,
}));
---

<Layout title="国际">
  <section>
    <h1 class="text-2xl sm:text-3xl font-bold text-[#1A1A1A] mb-2 pb-3 sm:pb-4 border-b-2 border-primary dark:text-white dark:border-[#b05223]">🌍 国际 · World</h1>
    <p class="text-sm sm:text-base text-[#666666] mb-4 sm:mb-6 dark:text-gray-400">世界地图 · 悬停查看国家官方全称与首都</p>

    <div class="map-breakout relative bg-white rounded-lg border border-gray-200 p-1 sm:p-2 dark:bg-[#0a1f47] dark:border-gray-700">
      <svg id="world-map" viewBox="0 0 1400 700" class="w-full h-auto block" role="img" aria-label="世界地图">
        {mapData.map((c) => (
          <path
            d={c.d}
            class={c.cn ? 'country cn' : 'country'}
            data-name={c.name}
            data-full={c.full}
            data-cap={c.cap}
            style={c.cn ? undefined : `--hc: ${c.hc}`}
          />
        ))}
        {dashPaths.map((d) => (
          <path d={d} class="dash-line" />
        ))}
      </svg>
      <div id="map-tip" class="map-tip"></div>
    </div>

    <p class="text-xs text-[#999] mt-3 dark:text-gray-500">中国版图含台湾地区与南海诸岛;地图为国家轮廓示意。</p>
  </section>
</Layout>

<style>
  .map-breakout {
    margin-left: -1rem;
    margin-right: -1rem;
  }
  @media (min-width: 640px) {
    .map-breakout {
      margin-left: -3rem;
      margin-right: -3rem;
    }
  }
  @media (min-width: 1024px) {
    .map-breakout {
      margin-left: -8rem;
      margin-right: -8rem;
    }
  }
  @media (min-width: 1280px) {
    .map-breakout {
      margin-left: -11rem;
      margin-right: -11rem;
    }
  }

  .country {
    fill: #e2e8f0;
    stroke: #94a3b8;
    stroke-width: 0.5;
    transition: fill 0.15s ease-out;
    cursor: pointer;
  }
  .country:hover {
    fill: var(--hc, #f59e0b);
  }
  .country.cn {
    fill: #fecaca;
    stroke: #e63946;
    stroke-width: 0.6;
  }
  .country.cn:hover {
    fill: #f87171;
  }
  .dash-line {
    fill: none;
    stroke: #e63946;
    stroke-width: 1.3;
    stroke-linecap: round;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-out;
  }
  .dash-line.show {
    opacity: 1;
  }
  .map-tip {
    position: absolute;
    pointer-events: none;
    background: #1a1a1a;
    color: #fff;
    font-size: 12px;
    line-height: 1.5;
    padding: 6px 12px;
    border-radius: 8px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease-out;
    white-space: nowrap;
    z-index: 10;
    text-align: left;
  }
  .map-tip .tip-name {
    font-size: 13px;
    font-weight: 600;
  }
  .map-tip.show {
    opacity: 1;
    visibility: visible;
  }
  .dark .map-tip {
    background: #e5e7eb;
    color: #1a1a1a;
  }
</style>

<script>
  const svg = document.getElementById('world-map');
  const tip = document.getElementById('map-tip');

  if (svg && tip) {
    // 悬停中国(含台湾)时显示南海九段线
    const dashLines = svg.querySelectorAll('.dash-line');
    const cnPaths = svg.querySelectorAll('path.country.cn');
    const showDash = () => dashLines.forEach((l) => l.classList.add('show'));
    const hideDash = () => dashLines.forEach((l) => l.classList.remove('show'));
    cnPaths.forEach((p) => {
      p.addEventListener('mouseenter', showDash);
      p.addEventListener('mouseleave', hideDash);
    });

    svg.addEventListener('mouseover', (e) => {
      const el = (e.target as HTMLElement).closest('.country') as SVGElement;
      if (!el) return;
      const name = el.getAttribute('data-name') ?? '';
      const full = el.getAttribute('data-full') ?? '';
      const cap = el.getAttribute('data-cap') ?? '';
      tip.innerHTML = `<span class="tip-name">${name}</span><br/>${full}<br/>${cap ? `首都:${cap}` : ''}`;
      tip.classList.add('show');
    });
    svg.addEventListener('mousemove', (e) => {
      tip.style.left = e.offsetX + 16 + 'px';
      tip.style.top = e.offsetY + 16 + 'px';
    });
    svg.addEventListener('mouseout', (e) => {
      const el = (e.target as HTMLElement).closest('.country') as SVGElement;
      if (!el) return;
      tip.classList.remove('show');
    });
  }
</script>
