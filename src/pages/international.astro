// 中国(含台湾)在数据中的 ISO 数值 id
const CHINA_ID = '156';
const TAIWAN_ID = '158';

const land: any = feature(world as any, (world as any).objects.countries as any);
const features: any[] = (land as any).features;

const projection = geoNaturalEarth1().fitSize([960, 500], land);
const path = geoPath(projection);

const isCN = (f: any) => f.id === CHINA_ID || f.id === TAIWAN_ID;
const nameOf = (f: any) => zhNames[f.properties.name] ?? f.properties.name;
---

<Layout title="国际">
  <section>
    <h1 class="text-2xl sm:text-3xl font-bold text-[#1A1A1A] mb-2 pb-3 sm:pb-4 border-b-2 border-primary dark:text-white dark:border-[#b05223]">🌍 国际 · World</h1>
    <p class="text-sm sm:text-base text-[#666666] mb-4 sm:mb-6 dark:text-gray-400">世界地图 · 将鼠标移动到国家上查看名称</p>

    <div class="relative bg-white rounded-lg border border-gray-200 p-2 sm:p-4 dark:bg-[#0a1f47] dark:border-gray-700">
      <svg id="world-map" viewBox="0 0 960 500" class="w-full h-auto block" role="img" aria-label="世界地图">
        {features.map((f) => (
          <path
            d={path(f) ?? ''}
            class={isCN(f) ? 'country cn' : 'country'}
            data-name={nameOf(f)}
          />
        ))}
      </svg>
      <div id="map-tip" class="map-tip"></div>
    </div>

    <p class="text-xs text-[#999] mt-3 dark:text-gray-500">地图为国家轮廓示意,中国含台湾地区;数据基于 Natural Earth。</p>
  </section>
</Layout>

<style>
  .country {
    fill: #e2e8f0;
    stroke: #94a3b8;
    stroke-width: 0.5;
    transition: fill 0.15s ease-out;
    cursor: pointer;
  }
  .country:hover {
    fill: #f59e0b;
  }
  .country.cn {
    fill: #fecaca;
    stroke: #e63946;
    stroke-width: 0.6;
  }
  .country.cn:hover {
    fill: #f87171;
  }
  .map-tip {
    position: absolute;
    pointer-events: none;
    background: #1a1a1a;
    color: #fff;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 6px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease-out;
    white-space: nowrap;
    z-index: 10;
  }
  .map-tip.show {
    opacity: 1;
    visibility: visible;
  }
  .dark .map-tip {
    background: #e5e7eb;
    color: #1a1a1a;
  }
</style>

<script>
  const svg = document.getElementById('world-map');
  const tip = document.getElementById('map-tip');

  if (svg && tip) {
    svg.addEventListener('mouseover', (e) => {
      const p = (e.target as HTMLElement).closest('path.country') as SVGPathElement;
      if (!p) return;
      tip.textContent = p.dataset.name ?? '';
      tip.classList.add('show');
    });
    svg.addEventListener('mousemove', (e) => {
      tip.style.left = e.offsetX + 14 + 'px';
      tip.style.top = e.offsetY + 14 + 'px';
    });
    svg.addEventListener('mouseout', (e) => {
      const p = (e.target as HTMLElement).closest('path.country') as SVGPathElement;
      if (!p) return;
      tip.classList.remove('show');
    });
  }
</script>
