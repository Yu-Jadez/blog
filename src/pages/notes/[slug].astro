---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import CategoryIndex from '../../components/CategoryIndex.astro';
import { BASE } from '../../consts';
import { stripMarkdown } from '../../utils';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const slugs = new Set<string>();
  const categorySet = new Set<string>();

  for (const n of notes) {
    const parts = n.id.split('/');
    if (parts.length === 1 && !n.id.endsWith('/index')) {
      slugs.add(n.id);
    } else if (parts.length >= 2) {
      categorySet.add(parts[0]);
      slugs.add(parts[0]);
    }
  }

  return [...slugs].map((slug) => {
    const isCategory = categorySet.has(slug);
    return { params: { slug }, props: { type: isCategory ? 'category' : 'post', slug } };
  });
}

const { type, slug } = Astro.props as { type: string; slug: string };
const notes = await getCollection('notes');

let pageTitle = '';
let ContentCmp: any = null;
let postData: any = null;
let catTitle = '';
let catDesc: string | undefined;
let catSubs: { name: string; path: string; count: number }[] = [];
let catPosts: any[] = [];
let catCrumbs: { label: string; href: string }[] = [];

if (type === 'post') {
  const note = notes.find((n) => n.id === slug);
  if (!note) throw new Error(`Note not found: ${slug}`);
  const rendered = await render(note);
  ContentCmp = rendered.Content;
  postData = note.data;
  pageTitle = note.data.title;
} else {
  const cat = slug;
  const indexNote = notes.find((n) => n.id === `${cat}/index`);
  catTitle = indexNote?.data.title || cat;
  catDesc = indexNote?.body ? stripMarkdown(indexNote.body ?? '', 200) : undefined;

  const subCats = new Map<string, number>();
  const posts: any[] = [];
  const prefix = cat + '/';
  for (const n of notes) {
    if (!n.id.startsWith(prefix)) continue;
    const relative = n.id.slice(prefix.length);
    const parts = relative.split('/');
    if (parts.length === 1 && relative !== 'index') {
      posts.push(n);
    } else if (parts.length >= 2) {
      subCats.set(parts[0], (subCats.get(parts[0]) || 0) + 1);
    }
  }
  posts.sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
  catPosts = posts;
  catSubs = [...subCats].map(([name, count]) => ({ name, path: `${cat}/${name}`, count }));
  catCrumbs = [
    { label: '笔记', href: `${BASE}/notes` },
    { label: catTitle, href: `${BASE}/notes/${cat}/` },
  ];
  pageTitle = catTitle;
}
---

<Layout title={pageTitle}>
  {
    type === 'post' ? (
      <article class="max-w-prose mx-auto">
        <header class="mb-8">
          <a
            href={`${BASE}/notes`}
            class="text-sm text-primary hover:text-primary-dark mb-4 inline-block dark:text-red-400 dark:hover:text-red-300"
          >
            ← 返回笔记
          </a>
          <h1 class="text-2xl sm:text-3xl font-bold text-[#1A1A1A] mb-3 dark:text-white">
            {postData.title}
          </h1>
          <div class="flex items-center gap-3 text-sm text-[#666666] dark:text-gray-400">
            <time datetime={postData.date.toISOString()}>
              {postData.date.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {postData.tags?.length > 0 && <span>·</span>}
            <div class="flex gap-2">
              {postData.tags?.map((tag: string) => (
                <span class="inline-block px-2 py-0.5 bg-primary/10 text-primary text-xs rounded-full dark:bg-red-500/20 dark:text-red-300">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </header>
        <div class="prose prose-lg max-w-none prose-a:text-primary prose-a:no-underline hover:prose-a:text-primary-dark dark:prose-invert">
          <ContentCmp />
        </div>
        <footer class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-700">
          <a
            href={`${BASE}/notes`}
            class="text-primary hover:text-primary-dark dark:text-red-400 dark:hover:text-red-300"
          >
            ← 返回笔记
          </a>
        </footer>
      </article>
    ) : (
      <CategoryIndex
        section="notes"
        title={catTitle}
        description={catDesc}
        breadcrumbs={catCrumbs}
        subCategories={catSubs}
        posts={catPosts}
      />
    )
  }
</Layout>
